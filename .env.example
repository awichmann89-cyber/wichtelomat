# ─── Datenbank (Neon) ─────────────────────────────────────────────
# Setzt die Neon-Integration in Vercel automatisch.
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Für Migrationen (direkte Verbindung, ebenfalls von der Integration gesetzt)
DATABASE_URL_UNPOOLED=postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ─── App ──────────────────────────────────────────────────────────
# Öffentliche URL – wird für die Links in den Mails verwendet
APP_URL=https://wichtelomat.alw-mediaworks.de
# Zufälliger, langer Wert:  openssl rand -base64 32
SESSION_SECRET=
# Vercel Cron schickt diesen Wert mit (Authorization: Bearer …)
CRON_SECRET=

# ─── Mailversand: SMTP ODER Resend ────────────────────────────────
MAIL_FROM="Wichtelomat <apps@alw-mediaworks.de>"

# a) SMTP (z. B. Postfach apps@alw-mediaworks.de beim Hoster)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=apps@alw-mediaworks.de
SMTP_PASS=

# b) Resend (hat Vorrang, wenn gesetzt) – Domain alw-mediaworks.de dort verifizieren
# RESEND_API_KEY=

# ─── Optional ─────────────────────────────────────────────────────
# Nur wer diesen Code kennt, darf neue Gruppen anlegen (schützt deine Absenderdomain vor Missbrauch)
CREATE_CODE=
# Link im Footer
IMPRESSUM_URL=
OPERATOR_NAME=
# Tage nach der Bescherung, bis eine Gruppe automatisch gelöscht wird
DELETE_AFTER_EVENT_DAYS=60
# Ruhezeit in Minuten, bevor neue Wünsche gebündelt an den Wichtel gemeldet werden
NOTIFY_DELAY_MINUTES=3

# ─── Nur lokal ────────────────────────────────────────────────────
# Mails nicht senden, sondern als Dateien in diesen Ordner schreiben
# MAIL_OUTBOX_DIR=.mail-outbox
